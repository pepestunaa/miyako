#!/bin/sh
# Require an evidence line on commits that change app source, so a fresh agent can resume from git
# alone when a session is cut short. The rule itself lives in agents.md.
#
# Activate in this clone:  cp .githooks/commit-msg .git/hooks/commit-msg
# Activate for every clone: git config core.hooksPath .githooks   (run this yourself)
# Self-test without staging: STEP_CHECKPOINT_SELFTEST=1 sh .githooks/commit-msg msg.txt

msg_file="$1"
[ -n "$msg_file" ] || exit 0

first_line=$(head -n 1 "$msg_file")
case "$first_line" in
	Merge* | Revert* | fixup!* | squash!*) exit 0 ;;
esac

if [ "$STEP_CHECKPOINT_SELFTEST" = "1" ]; then
	staged="app/src/main/java/eu/kanade/tachiyomi/ui/manga/Scratch.kt"
else
	staged=$(git diff --cached --name-only)
fi

printf '%s\n' "$staged" | grep -q '^app/src/main/' || exit 0

grep -Eq '^evidence: build=(ok|fail|n/a) [|] verify=(PASS|PENDING|N/A) [|] next=.+' "$msg_file" && exit 0

cat >&2 <<'EOF'
Commit rejected: this change edits app source.

Add one evidence line to the commit body (see "Checkpoint dan Oper Antar Agent" in agents.md):
	evidence: build=ok | verify=PENDING | next=<one step>

build:   ok | fail | n/a
verify:  PASS only after the on-device audit or test for this change actually ran;
         PENDING when it compiled but was not exercised; N/A for non-behavioural edits.
next:    the single thing the next session should do.
EOF
exit 1
