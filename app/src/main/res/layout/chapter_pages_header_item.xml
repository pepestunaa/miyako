<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/background"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/chapter_pages_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?textAppearanceBodyMedium"
        tools:text="Ch. 6 - Summer Trip" />

    <TextView
        android:id="@+id/chapter_pages_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="24 pages"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/chapter_pages_progress"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:indeterminateTint="?attr/colorSecondary"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/chapter_pages_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?textAppearanceBodySmall"
        android:textColor="?attr/colorSecondary"
        android:visibility="gone"
        tools:text="Retry"
        tools:visibility="visible" />

</LinearLayout>
